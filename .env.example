# ==== RouterAI / LLM ====
# ОБЯЗАТЕЛЬНО: ключ с https://routerai.ru
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_TIMEOUT=300.0
MAX_RETRIES=3
RETRY_BACKOFF=2.0
TEMPERATURE=0.2
SERVICE_TIER=default
WEB_SEARCH_ENGINE=native
WEB_SEARCH_MAX_RESULTS=5

# ==== Модели ====
MODEL_MAIN=deepseek/deepseek-v4-flash
# Пусто = дефолт config.py (v4-flash, v4.1-flash, haiku-5.5, gemini-4-argon)
CURATED_MODEL_IDS=
DEFAULT_MODEL_ID=deepseek/deepseek-v4-flash
MODEL_ROUTER_ENABLED=1
CONTEXT_FILL_RATIO=0.8

# ==== Каталог моделей (кэш) ====
MODELS_CACHE_TTL=24
MODELS_CACHE_DIR=~/.cache/agent-coder
MODELS_API_TIMEOUT=5.0

# ==== Сжатие истории и медиа ====
MAX_HISTORY_TOKENS=90000
SUMMARY_MODEL=anthropic/claude-haiku-5.5
MEDIA_RETENTION_DAYS=30

# ==== Агент и окружение ====
DEFAULT_WORKSPACE=~/projects
AGENT_CODER_AGENTS_MD_MAX_BYTES=8192
SHARED_DEV_DIR=~/bots/_shared-dev/project-template/
MAX_ITERATIONS=200
MAX_ITERATIONS_PLAN=100
MAX_ITERATIONS_ACT=200
MAX_ITERATIONS_AUDIT=200
LOG_LEVEL=INFO

# ==== Надёжность / авто-продолжение ====
MAX_AUTO_CONTINUE=3
MAX_CONSECUTIVE_ERRORS=5
MAX_ITERATIONS_NO_PROGRESS=10
WORK_STATE_DEDUP=1

# ==== Вспомогательные модели ====
PATCH_MODEL_ID=deepseek/deepseek-v4.1-flash
PATCH_REASONING_EFFORT=low
VERIFY_MODEL_ID=anthropic/claude-haiku-5.5

# ==== Бюджеты и таймауты (₽, per-session/task) ====
MAX_COST_PER_SESSION=300.0
MAX_COST_PER_TASK=200.0
MAX_COST_VERIFY=50.0
MAX_COST_PATCH=50.0
MAX_PATCH_ITERATIONS=60
PATCH_CHAT_TIMEOUT=180.0

# ==== Инструменты ====
# Глобальный лимит символов в tool-output (пусто = DEFAULT_LIMITS[tool]).
# Специфичный tool: TOOL_MAX_CHARS_<NAME> (напр. TOOL_MAX_CHARS_SEARCH),
# приоритет выше глобального. Динамические имена в .env.example не перечисляем.
TOOL_MAX_CHARS=

# Опциональный оверрайд каталога сессий (по умолчанию BASE_DIR/sessions)
# SESSIONS_DIR=

# ==== Telegram ====
TELEGRAM_TOKEN=
TELEGRAM_USER_ID=0
TELEGRAM_PROJECTS_DIRS=~/projects,~/bots
APPROVAL_TIMEOUT=900

# ==== GitHub ====
GITHUB_TOKEN=
