# ==== RouterAI / LLM ====
# ОБЯЗАТЕЛЬНО: ключ с https://routerai.ru
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_TIMEOUT=300.0
MAX_RETRIES=3
RETRY_BACKOFF=2.0
TEMPERATURE=0.2
SERVICE_TIER=flex
# Лимит токенов ответа на запрос (страховка от «улетевшей» генерации).
# 0 — не отправлять, доверить провайдеру (он разрешает до 128K–1M).
MAX_OUTPUT_TOKENS=32768
# exa в ~16 раз дешевле native при том же ответе (native тянет страницы).
WEB_SEARCH_ENGINE=exa
# Поиском управляет активная модель по вызову инструмента web_search.
WEB_SEARCH_MAX_RESULTS=5
# Модель для web_search (обычно дешёвая). Пусто = активная модель сессии.
WEB_SEARCH_MODEL=

# ==== Модели ====
MODEL_MAIN=deepseek/deepseek-v4.1-flash-1017
# Пусто = дефолт config.py (8 моделей: DeepSeek Flash, Haiku, GPT-6 Luna Pro, DeepSeek V4 Pro, GPT-6.1 Terra Pro, Sonnet, GPT-6.1 Sol Pro, Opus)
CURATED_MODEL_IDS=
DEFAULT_MODEL_ID=deepseek/deepseek-v4.1-flash-1017
MODEL_ROUTER_ENABLED=1
CONTEXT_FILL_RATIO=0.8

# ==== Каталог моделей (кэш) ====
MODELS_CACHE_TTL=24
MODELS_CACHE_DIR=~/.cache/agent-coder
MODELS_API_TIMEOUT=5.0

# ==== Сжатие истории и медиа ====
MAX_HISTORY_TOKENS=90000
# Опциональные per-model пороги истории (model_id=tokens,...).
# Здесь записан дефолт кода (curated long-context лимиты). Пустое значение =
# для всех моделей действует MAX_HISTORY_TOKENS.
MODEL_HISTORY_TOKEN_LIMITS=deepseek/deepseek-v4.1-flash-1017=400000,deepseek/deepseek-v4-pro-0813=400000,anthropic/claude-haiku-5.5=90000,openai/gpt-6-luna=250000,openai/gpt-6.1-terra=250000,openai/gpt-6.1-sol=250000,anthropic/claude-sonnet-5.5=400000,anthropic/claude-opus-5.5=400000
SUMMARY_MODEL=openai/gpt-6-luna
# Старые сессии без активности удаляются вместе с архивами/отчётами/медиа.
SESSION_RETENTION_DAYS=30
MEDIA_RETENTION_DAYS=30

# ==== Агент и окружение ====
DEFAULT_WORKSPACE=~/projects
AGENT_CODER_AGENTS_MD_MAX_BYTES=8192
MAX_ITERATIONS=200
MAX_ITERATIONS_PLAN=100
MAX_ITERATIONS_ACT=200
MAX_ITERATIONS_AUDIT=200
LOG_LEVEL=INFO

# ==== Надёжность / авто-продолжение ====
MAX_AUTO_CONTINUE=3
MAX_CONSECUTIVE_ERRORS=5
MAX_ITERATIONS_NO_PROGRESS=10
MAX_READ_ONLY_ITERATIONS_ACT=20
MAX_IDENTICAL_CALLS=3
WORK_STATE_DEDUP=1

# ==== Вспомогательные модели ====
PATCH_MODEL_ID=deepseek/deepseek-v4.1-flash-1017
PATCH_REASONING_EFFORT=low
VERIFY_MODEL_ID=anthropic/claude-haiku-5.5

# ==== Бюджеты и таймауты (₽, per-session/task) ====
MAX_COST_PER_SESSION=300.0
# Защита кеша провайдера: стоп сессии, если cache_read упал ниже RATIO×prev_input
# на STREAK запросах подряд (input >= MIN_INPUT). См. agent/cache_guard.py.
CACHE_GUARD_ENABLED=1
CACHE_GUARD_MIN_INPUT=20000
CACHE_GUARD_RATIO=0.5
CACHE_GUARD_STREAK=2
MAX_COST_PER_TASK=200.0
MAX_COST_VERIFY=50.0
MAX_COST_PATCH=50.0
MAX_PATCH_ITERATIONS=60
PATCH_CHAT_TIMEOUT=180.0

# ==== Инструменты ====
# Глобальный лимит символов в tool-output (пусто = DEFAULT_LIMITS[tool]).
# Специфичный tool: TOOL_MAX_CHARS_<NAME> (напр. TOOL_MAX_CHARS_SEARCH),
# приоритет выше глобального. Динамические имена в .env.example не перечисляем.
TOOL_MAX_CHARS=

# Опциональный оверрайд каталога сессий (по умолчанию BASE_DIR/sessions)
# SESSIONS_DIR=

# ==== Telegram ====
TELEGRAM_TOKEN=
TELEGRAM_USER_ID=0
TELEGRAM_PROJECTS_DIRS=~/projects,~/bots
APPROVAL_TIMEOUT=900

# ==== GitHub ====
GITHUB_TOKEN=
