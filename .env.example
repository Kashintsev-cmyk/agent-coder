# ==== RouterAI / LLM ====
# ОБЯЗАТЕЛЬНО: ключ с https://routerai.ru
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_TIMEOUT=300.0
MAX_RETRIES=3
RETRY_BACKOFF=2.0
TEMPERATURE=0.2
SERVICE_TIER=default
WEB_SEARCH_ENGINE=native
WEB_SEARCH_MAX_RESULTS=5

# ==== Модели ====
MODEL_MAIN=deepseek/deepseek-v4.1-flash
# Зарезервировано, в коде не используется
MODEL_FAST=
CURATED_MODEL_IDS=deepseek/deepseek-v4.1-flash,z-ai/glm-5.3-flash,qwen/qwen3-coder-next,z-ai/glm-5.3,moonshotai/kimi-k2.7-code,deepseek/deepseek-r1,openai/gpt-6.1-sol,anthropic/claude-sonnet-5.5
DEFAULT_MODEL_ID=deepseek/deepseek-v4.1-flash
CODING_MODEL_IDS=deepseek/deepseek-v4.1-flash,z-ai/glm-5.3-flash,qwen/qwen3-coder-next
AUDIT_MODEL_IDS=z-ai/glm-5.3,moonshotai/kimi-k2.7-code,deepseek/deepseek-r1
MODEL_ROUTER_ENABLED=1
CONTEXT_FILL_RATIO=0.8

# ==== Каталог моделей (кэш) ====
MODELS_CACHE_TTL=24
MODELS_CACHE_DIR=~/.cache/agent-coder
MODELS_API_TIMEOUT=5.0

# ==== Сжатие истории и медиа ====
MAX_HISTORY_TOKENS=60000
SUMMARY_MODEL=z-ai/glm-5.3-flash
MEDIA_RETENTION_DAYS=30

# ==== Агент и окружение ====
DEFAULT_WORKSPACE=~/projects
AGENT_CODER_AGENTS_MD_MAX_BYTES=8192
SHARED_DEV_DIR=~/bots/_shared-dev/project-template/
MAX_ITERATIONS=50
MAX_ITERATIONS_PLAN=30
MAX_ITERATIONS_ACT=50
MAX_ITERATIONS_AUDIT=100
LOG_LEVEL=INFO

# ==== Telegram ====
TELEGRAM_TOKEN=
TELEGRAM_USER_ID=0
TELEGRAM_PROJECTS_DIRS=~/projects,~/bots
APPROVAL_TIMEOUT=900

# ==== GitHub ====
GITHUB_TOKEN=
