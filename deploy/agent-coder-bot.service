[Unit]
Description=agent-coder Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
# botuser в группе docker — нужно для команд docker ps/images/... из /server
# M6: SupplementaryGroups=docker удалено — docker-группа = root-эквивалент.
# Read-only docker (/server → 🐳) идёт через sudo -n с узким sudoers:
# см. deploy/agent-coder-docker.sudoers и docs/ENVIRONMENT.md.
WorkingDirectory=/home/botuser/bots/agent-coder
Environment=PATH=/home/botuser/bots/agent-coder/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/botuser/bots/agent-coder/.venv/bin/agent-coder-bot
Restart=always
RestartSec=5

# Корректная остановка: SIGTERM → дождаться прерывания активных задач
KillSignal=SIGTERM
TimeoutStopSec=30
TimeoutStartSec=30

# Hardening: минимум привилегий
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

# Что боту разрешено писать:
# - sessions/ (история, медиа, отчёты, индекс сессий)
# - telegram_state.json (active session)
# - ~/.cache/agent-coder (кэш каталога моделей)
ReadWritePaths=/home/botuser/bots/agent-coder/sessions
ReadWritePaths=-/home/botuser/.cache/agent-coder
# Куда бот создаёт новые проекты (папки) и куда клонирует репо
ReadWritePaths=-/home/botuser/bots
ReadWritePaths=-/home/botuser/projects

# M7: код, тесты, конфиги и docs бота — read-only. Бот не должен
# перезаписывать собственный код (prompt-injection / баг в write_file).
# Перечисление подкаталогов и файлов, НЕ содержащих sessions/:
# вложенный RO-родитель + RW-внук (sessions) в systemd 249 ведёт себя
# непредсказуемо, поэтому не накрываем корень agent-coder/ целиком.
# .git/ и .venv/ оставлены RW (git_commit / рантайм .venv).
ReadOnlyPaths=/home/botuser/bots/agent-coder/agent_coder
ReadOnlyPaths=/home/botuser/bots/agent-coder/tests
ReadOnlyPaths=/home/botuser/bots/agent-coder/deploy
ReadOnlyPaths=/home/botuser/bots/agent-coder/docs
ReadOnlyPaths=/home/botuser/bots/agent-coder/benchmark
ReadOnlyPaths=/home/botuser/bots/agent-coder/.github
ReadOnlyPaths=/home/botuser/bots/agent-coder/pyproject.toml
ReadOnlyPaths=/home/botuser/bots/agent-coder/AGENTS.md
ReadOnlyPaths=/home/botuser/bots/agent-coder/.env
ReadOnlyPaths=/home/botuser/bots/agent-coder/.env.example
ReadOnlyPaths=/home/botuser/bots/agent-coder/README.md
ReadOnlyPaths=/home/botuser/bots/agent-coder/LICENSE
ReadOnlyPaths=/home/botuser/bots/agent-coder/.gitignore
ReadOnlyPaths=/home/botuser/bots/agent-coder/.pre-commit-config.yaml

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
